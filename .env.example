# This server does not load .env files automatically. This file documents
# the environment variables it reads — export them in the shell (or your
# process manager) before running `npm start`.

# --- Super Productivity Local REST API (the upstream this server proxies) ---

# Base URL of Super Productivity's Local REST API. Only change this if you're
# running the server on a different machine than Super Productivity itself
# (e.g. reaching it over a private network) — the port is fixed at 3876 and
# not configurable on the Super Productivity side.
SP_REST_BASE_URL=http://127.0.0.1:3876

# Some Super Productivity versions require an access token for the Local
# REST API (Settings -> Misc -> Access Token). Leave empty if yours doesn't
# ask for one — the server will work fine without it.
SP_REST_TOKEN=

# --- This MCP server's own HTTP endpoint (what MCP clients connect to) ---

# Interface to bind to. Keep 127.0.0.1 so only local clients (Claude Cowork,
# Claude Desktop, etc. running on this machine) can reach it.
MCP_HTTP_HOST=127.0.0.1

# Port for the MCP endpoint. 3877 sits right next to Super Productivity's 3876.
MCP_HTTP_PORT=3877

# Path the MCP endpoint is served under. Clients connect to
# http://127.0.0.1:3877/mcp by default.
MCP_HTTP_PATH=/mcp
